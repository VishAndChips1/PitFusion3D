            </image>
            <clip>
              <near>__CAMERA_NEAR_CLIP__</near>
              <far>__CAMERA_FAR_CLIP__</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>__CAMERA_UPDATE_RATE__</update_rate>
