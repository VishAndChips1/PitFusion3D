Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: RGB Camera
      Normalize Range: true
      Queue Size: 10
      Topic: __ROS_RGB_IMAGE_TOPIC__
      Unreliable: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Thermal Camera
      Normalize Range: true
      Queue Size: 10
      Topic: __ROS_THERMAL_IMAGE_TOPIC__
      Unreliable: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Livox Lidar (raw)
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic: __ROS_LIDAR_POINTS_TOPIC__
      Unreliable: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Fused (RGB+thermal, 1 scan)
      Color Transformer: RGB8
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic: __ROS_FUSION_POINTS_TOPIC__
      Unreliable: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Merged (1s window, ICP)
      Color Transformer: RGB8
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic: __ROS_MERGED_POINTS_TOPIC__
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 36
    Fixed Frame: __FIXED_FRAME__
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Current View
      Pitch: 0.75
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1600
  RGB Camera:
    collapsed: false
  Thermal Camera:
    collapsed: false
