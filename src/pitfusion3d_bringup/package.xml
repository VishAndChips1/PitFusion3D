<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pitfusion3d_bringup</name>
  <version>0.1.0</version>
  <description>Real-hardware sensor drivers (RPi RGB camera, UVC thermal camera) and bringup launch files for PitFusion3D, replacing the Gazebo simulation with the physical rig (Livox Avia + rpicam + thermal UVC camera).</description>
  <maintainer email="vishy300@gmail.com">vish</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>livox_ros2_avia</exec_depend>
  <exec_depend>landfill_camera_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
