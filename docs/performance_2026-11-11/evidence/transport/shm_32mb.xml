<?xml version="1.0" encoding="UTF-8"?>
<!--
Fast DDS profile for the single-host PitFusion3D pipeline.

Why shared memory: a 1280x720 rgb8 frame is ~2.7MB, a fused cloud ~0.6MB.
Fast DDS's built-in shared-memory transport has a small default segment, so
these messages fall back to UDP over loopback, where this Pi's kernel socket
buffer ceiling (net.core.rmem_max = 212992, not raisable without root)
silently drops fragments. Measured 2026-11-11 with synthetic traffic at the
real sizes/rates (15Hz rgb, 30Hz thermal, 10Hz cloud), received rates:
  default / UDP-4MB profile : rgb ~7Hz,  thermal ~16Hz, cloud ~5-6Hz
  this profile (SHM 128MB)  : rgb ~14Hz, thermal ~28Hz, cloud ~9.4Hz
UDP is kept alongside SHM for participant discovery and for any peer that
doesn't load this profile (those peers still work, but get the lossy UDP path
for big messages -- so set FASTRTPS_DEFAULT_PROFILES_FILE to this file when
measuring from a shell, e.g. `ros2 topic hz`, or the numbers will look low).
Original UDP-only profile: ~/thesis_tests/fastdds_large_buffers.xml.pre_shm_20261111
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_big</transport_id>
        <type>SHM</type>
        <segment_size>33554432</segment_size>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_big</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="pitfusion3d_shm_large" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_big</transport_id>
          <transport_id>udp_big</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
